{
  // =======================================================================================
  // 1. CONNECTION STRINGS (The Map to the Database)
  // =======================================================================================
  // This section holds the exact addresses and keys needed to talk to your SQL database.
  "ConnectionStrings": {

    // "CatShelterDB" is a nickname. Your C# code will ask for this nickname to get the address.
    "CatShelterDB": "Server=YOUR_SQL_SERVER;Database=CatShelterDB;Integrated Security=True;TrustServerCertificate=True"
  },


  // =======================================================================================
  // 2. LOGGING (The "Walkie-Talkie" System)
  // =======================================================================================
  // DEFINITION: Controls how "chatty" the server is in your black terminal window.
  // There are two "Teams" of code running in your app: 
  //   1. Your Team (The C# code you wrote)
  //   2. Microsoft's Team (The background framework making the server run)
  // 
  // THE LEVELS (From most chatty to emergencies only):
  // 1. Trace       (Extreme detail / Micro-movements)
  // 2. Debug       (Developer notes / Variable checks)
  // 3. Information (Normal updates / Proves things are working)
  // 4. Warning     (Something is weird, but we are alive)
  // 5. Error       (Something broke, like a database save failing)
  // 6. Critical    (Total disaster, server shutting down)
  //
  // THE RULE: You will ONLY hear messages at the level you set AND HIGHER.
  // =======================================================================================
  "Logging": {
    "LogLevel": {

      // RULE 1: YOUR TEAM (The General Rule)
      // We set this to "Information". 
      // This means we want to see normal updates, warnings, and errors from OUR code.
      // We are filtering out the annoying Trace and Debug static.
      "Default": "Information",

      // RULE 2: MICROSOFT'S TEAM (The Override/Muzzle)
      // Microsoft's background code does thousands of things a second. If we let them 
      // talk at the "Information" level, they would flood our terminal window with text. 
      // 
      // By adding this specific rule, we say: "Microsoft, you talk too much. For you 
      // specifically, I am turning the dial up to Warning. Do not talk to me unless 
      // something is actually breaking."
      "Microsoft.AspNetCore": "Warning"
    }
  },


  // =======================================================================================
  // 3. ALLOWED HOSTS (The Bouncer's VIP List)
  // =======================================================================================
  // This is a basic security layer that dictates which IP addresses or domain names 
  // are allowed to access this server. 
  // The "*" is a wildcard meaning "Accept requests from ANY domain name."
  "AllowedHosts": "*"
}
